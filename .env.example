# Copy to .env and fill in real values. Never commit .env itself.

# --- Discord ---------------------------------------------------------------
# Channel -> Edit Channel -> Integrations -> Webhooks.
DISCORD_WEBHOOK_URL=
# Optional. Your numeric Discord user id, used to @mention you on an alert.
# Enable Developer Mode (Settings -> Advanced), then right-click your name ->
# Copy User ID. Messages still post without it, just without the ping.
DISCORD_USER_ID=

# --- Amazon delivery destination -------------------------------------------
# Every market is pinned to one destination so their answers mean the same
# thing; without it Amazon geolocates a different country per marketplace.
DELIVERY_COUNTRY=Sweden
# Used on the domestic market only. Kept here rather than in config/sites.yaml
# because a postcode identifies a town and that file is committed. No space.
DELIVERY_POSTCODE=
